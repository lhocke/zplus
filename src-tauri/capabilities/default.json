{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main Z+ window",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "dialog:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": ["$APPDATA/saves", "$APPDATA/saves/**"]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.github.com/*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/lhocke/zplus/releases/*" }]
    }
  ]
}
